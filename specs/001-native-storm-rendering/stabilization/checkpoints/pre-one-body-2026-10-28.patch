+                float[] d = k == 0 ? new float[]{0, -1, 0} : dir18(k <= 6 ? -60 : k <= 12 ? -30 : -10, sunAz + 60 * ((k - 1) % 6) + 30 * (((k - 1) / 6) & 1));
